{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algophony.sonicfieldlabs.org/schemas/benchmark-run.schema.json",
  "title": "Algophony Benchmark Score Record",
  "description": "Schema for one scored generation in an Algophony benchmark suite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "prompt_id",
    "audio_id",
    "report_id",
    "model",
    "score_sets",
    "score_provenance",
    "final_scores",
    "date"
  ],
  "properties": {
    "suite_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "prompt_id": { "type": "string", "pattern": "^ALG-[0-9]{4}$" },
    "audio_id": { "type": "string", "pattern": "^ALG-[0-9]{4}-[A-Z0-9-]+-[A-Z]$" },
    "report_id": { "type": "string", "pattern": "^AK-[0-9]{4}$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version", "type"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["procedural_control", "ml_model", "hybrid", "spatial_procedural"] }
      }
    },
    "score_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_scores", "agent_scores", "human_scores", "final_scores"],
      "properties": {
        "signal_scores": { "$ref": "score.schema.json" },
        "agent_scores": { "$ref": "score.schema.json" },
        "human_scores": {
          "oneOf": [
            { "$ref": "score.schema.json" },
            { "type": "null" }
          ]
        },
        "final_scores": { "$ref": "score.schema.json" }
      }
    },
    "score_provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "listening-report.schema.json#/$defs/score_provenance" }
    },
    "final_scores": { "$ref": "score.schema.json" },
    "date": { "type": "string", "format": "date" }
  }
}
