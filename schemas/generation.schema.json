{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algophony.sonicfieldlabs.org/schemas/generation.schema.json",
  "title": "Algophony Generation Record",
  "description": "Schema for generated or uploaded soundscape metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audio_id",
    "prompt_id",
    "model",
    "model_version",
    "generation_date",
    "duration",
    "seed",
    "parameters",
    "license_status",
    "file_format",
    "storage_uri",
    "sha256",
    "human_notes",
    "akouo_report_id",
    "source_type"
  ],
  "properties": {
    "audio_id": { "type": "string", "pattern": "^ALG-[0-9]{4}-[A-Z0-9-]+-[A-Z]$" },
    "prompt_id": { "type": "string", "pattern": "^ALG-[0-9]{4}$" },
    "model": { "type": "string", "minLength": 1 },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "needs verification" }
    },
    "generation_date": { "type": "string", "format": "date" },
    "duration": { "type": "number", "minimum": 0 },
    "seed": { "type": ["integer", "null"] },
    "parameters": { "type": "object", "additionalProperties": true },
    "license_status": { "type": "string", "minLength": 1 },
    "file_format": { "type": "string", "enum": ["wav", "mp3", "flac", "aiff", "ogg"] },
    "storage_uri": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(/U[s]ers/|/h[o]me/|[A-Za-z]:\\\\)"}
    },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "human_notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "akouo_report_id": { "type": "string", "pattern": "^AK-[0-9]{4}$" },
    "source_type": {
      "type": "string",
      "enum": ["generated_procedural", "generated_ml", "field_recording", "found_sound", "hybrid"],
      "description": "Provenance of the audio: generated by algorithm, captured in the field, sourced from archive, or mixed."
    },
    "upload_metadata": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "original_filename": { "type": "string" },
            "recorder": { "type": "string" },
            "location": { "type": "string" },
            "date_recorded": { "type": "string" },
            "equipment": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      ],
      "default": null,
      "description": "Metadata for uploaded field recordings or found sounds."
    },
    "compute_provenance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_locality"],
          "properties": {
            "runtime_locality": {
              "type": "string",
              "enum": ["local", "cloud_api", "hosted_endpoint", "hybrid", "undetermined"]
            },
            "hardware": { "type": "string" },
            "region": { "type": "string" },
            "energy_note": { "type": "string" }
          }
        }
      ],
      "default": null,
      "description": "Material footprint of the generation. Every generated sound has a body somewhere: electricity, water, hardware, heat, labor. Records where the computation ran and on what. Null for records that predate this field."
    },
    "voice_material": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contains_voice_like_material", "consent_status"],
          "properties": {
            "contains_voice_like_material": { "type": "boolean" },
            "voice_source": {
              "type": "string",
              "enum": ["none", "synthetic_tts", "cloned", "recorded_consented", "recorded_unverified", "undetermined"]
            },
            "consent_status": {
              "type": "string",
              "enum": ["not_applicable", "consented", "unverified", "undetermined"]
            },
            "notes": { "type": "string" }
          }
        }
      ],
      "default": null,
      "description": "Voice-as-body record. The voice is biometric: consent for the human voice, provenance for the synthetic one. Null for records that predate this field or contain no voice-like material."
    }
  }
}
