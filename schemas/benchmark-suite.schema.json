{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algophony.sonicfieldlabs.org/schemas/benchmark-suite.schema.json",
  "title": "Algophony Benchmark Suite",
  "description": "Canonical schema for an Algophony benchmark suite manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "description",
    "benchmark_status",
    "date",
    "focus",
    "prompt_corpus",
    "prompt_ids",
    "categories",
    "models_compared",
    "score_axes",
    "listening_framework",
    "claim_taxonomy",
    "total_generations",
    "total_reports",
    "methodology",
    "dataset_card",
    "scores_file",
    "exports"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_status": {
      "type": "string",
      "enum": ["procedural_pilot", "ml_benchmark", "hybrid_benchmark", "archived"]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "focus": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "prompt_corpus": {
      "type": "string",
      "minLength": 1
    },
    "prompt_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ALG-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "models_compared": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model_entry" }
    },
    "score_axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/score_axis" }
    },
    "listening_framework": {
      "type": "string",
      "minLength": 1
    },
    "claim_taxonomy": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["heard", "measured", "inferred", "interpreted", "speculative", "undetermined"]
      },
      "uniqueItems": true
    },
    "total_generations": {
      "type": "integer",
      "minimum": 0
    },
    "total_reports": {
      "type": "integer",
      "minimum": 0
    },
    "public_subset_count": {
      "type": "integer",
      "minimum": 0
    },
    "ml_generation_count": {
      "type": "integer",
      "minimum": 0
    },
    "procedural_generation_count": {
      "type": "integer",
      "minimum": 0
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "dataset_card": {
      "type": "string",
      "minLength": 1
    },
    "scores_file": {
      "type": "string",
      "minLength": 1
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csv", "markdown", "json"],
      "properties": {
        "csv": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 },
        "json": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    }
  },
  "$defs": {
    "model_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "name", "type", "status", "description", "synthesis_method"],
      "properties": {
        "provider_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["procedural_control", "ml_model", "hybrid", "spatial_procedural"] },
        "status": {
          "type": "string",
          "enum": ["available", "configured_missing_key", "not_installed", "not_implemented", "failed"]
        },
        "description": { "type": "string", "minLength": 1 },
        "synthesis_method": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "score_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "range", "direction", "description"],
      "properties": {
        "axis": { "type": "string", "minLength": 1 },
        "range": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "direction": { "type": "string", "enum": ["higher_is_better", "lower_is_better"] },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
