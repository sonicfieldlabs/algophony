{
  "name": "algophony-studio",
  "version": "0.5.4",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "dev:local": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "dev:daemon": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "build": "next build",
    "start": "next start",
    "start:local": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "audit:deps": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.2",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "fast-copy": "^4.0.5",
    "nanoid": "^3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2",
    "ws": "^8.20.1",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "browserslist": "4.28.7",
    "js-yaml@4": "4.3.2"
  },
  "packageManager": "npm@11.19.1"
}
