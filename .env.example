# Default provider resolution
ALGOPHONY_DEFAULT_PROVIDERS=el_sfx,stable_audio_3_stability_api,stable_audio_25_stability_api,stable_audio_25_fal,stable_audio_25_replicate,tangoflux_local,stable_audio_open_local,audiogen_local,moss_sfx_mlx,moss_sfx_local
ALGOPHONY_ALLOW_PROCEDURAL_FALLBACK=false

# ElevenLabs
ALGOPHONY_ELEVENLABS_API_KEY=
ALGOPHONY_ELEVENLABS_MODEL_ID=eleven_text_to_sound_v2

# Stability API. Endpoints are configurable because public endpoint docs may change.
ALGOPHONY_STABILITY_API_KEY=
ALGOPHONY_STABILITY_API_BASE_URL=https://api.stability.ai
ALGOPHONY_STABLE_AUDIO_3_ENDPOINT=
ALGOPHONY_STABLE_AUDIO_25_ENDPOINT=
ALGOPHONY_STABILITY_PAYLOAD_MODE=multipart
ALGOPHONY_STABLE_AUDIO_OUTPUT_FORMAT=mp3

# LLM listening augmentation (disabled by default)
ALGOPHONY_ENABLE_LLM_LISTENING=false
ALGOPHONY_LLM_BACKEND=codex_cli
ALGOPHONY_LLM_MODEL=
ALGOPHONY_LLM_TIMEOUT_SECONDS=180

# fal
FAL_KEY=
ALGOPHONY_FAL_STABLE_AUDIO_25_MODEL=fal-ai/stable-audio-25/text-to-audio

# Replicate
REPLICATE_API_TOKEN=
ALGOPHONY_REPLICATE_STABLE_AUDIO_25_MODEL=stability-ai/stable-audio-2.5

# AudioGen local
ALGOPHONY_AUDIOGEN_MODEL_ID=facebook/audiogen-medium
ALGOPHONY_AUDIOGEN_MODEL_PATH=
ALGOPHONY_AUDIOGEN_DEVICE=auto
ALGOPHONY_AUDIOGEN_MAX_DURATION=30

# MOSS SoundEffect local
ALGOPHONY_MOSS_SFX_MODEL_ID=OpenMOSS-Team/MOSS-SoundEffect
ALGOPHONY_MOSS_SFX_MODEL_PATH=
ALGOPHONY_MOSS_SFX_DEVICE=auto
ALGOPHONY_MOSS_SFX_TRUST_REMOTE_CODE=false
ALGOPHONY_MOSS_SFX_MAX_DURATION=30

# MOSS SoundEffect MLX
ALGOPHONY_MOSS_SFX_MLX_MODEL_PATH=
ALGOPHONY_MOSS_SFX_MLX_SCRIPT=
ALGOPHONY_MOSS_SFX_MLX_MAX_DURATION=30

# Stable Audio Open 1.0 local
ALGOPHONY_STABLE_AUDIO_OPEN_MODEL_ID=stabilityai/stable-audio-open-1.0
ALGOPHONY_STABLE_AUDIO_OPEN_MODEL_PATH=
ALGOPHONY_STABLE_AUDIO_OPEN_DEVICE=auto
ALGOPHONY_STABLE_AUDIO_OPEN_MAX_DURATION=47

# TangoFlux local
ALGOPHONY_TANGOFLUX_MODEL_ID=declare-lab/TangoFlux
ALGOPHONY_TANGOFLUX_MODEL_PATH=
ALGOPHONY_TANGOFLUX_DEVICE=auto
ALGOPHONY_TANGOFLUX_STEPS=25
ALGOPHONY_TANGOFLUX_MAX_DURATION=30

# User-hosted Hugging Face endpoints
ALGOPHONY_HF_TOKEN=
ALGOPHONY_AUDIOGEN_HF_ENDPOINT=
ALGOPHONY_MOSS_SFX_HF_ENDPOINT=
ALGOPHONY_STABLE_AUDIO_OPEN_HF_ENDPOINT=
ALGOPHONY_TANGOFLUX_HF_ENDPOINT=

# Storage
ALGOPHONY_DATA_ROOT=
ALGOPHONY_AUDIO_STORAGE_DIR=generations/audio
ALGOPHONY_EXPORT_DIR=benchmark/exports

# Dashboard (apps/web)
# Enable the Playground (interactive generation + upload). When unset or "false",
# /playground, /api/generate and /api/upload return 404.
ALGOPHONY_ENABLE_STUDIO=false
# Optional shared-secret for Studio API access. When set, /api/generate and
# /api/upload require an `x-studio-token` header matching this value. When
# unset, those endpoints are restricted to localhost-only callers.
ALGOPHONY_STUDIO_TOKEN=
# Max concurrent Studio subprocesses (default: 2). Higher values can starve the
# Node event loop because the Python pipeline is heavy.
ALGOPHONY_STUDIO_MAX_CONCURRENT=2
